# Sao chép file này thành .env rồi điền giá trị. KHÔNG đưa file .env lên GitHub.

# --- Chạy server ---
PORT=4000
# Địa chỉ giao diện web (dùng cho CORS và chuyển hướng sau khi đăng nhập)
FRONTEND_URL=http://localhost:3000
# Địa chỉ backend mà trình duyệt truy cập được (dùng làm callback của GitHub OAuth)
API_URL=http://localhost:4000
NODE_ENV=development

# --- Database (Supabase: Connect > ORM > Session pooler) ---
# Thay [YOUR-PASSWORD] bằng mật khẩu database. Không thêm ?sslmode=... vào cuối.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# Supabase cần true. Postgres cài trên máy thì đặt false.
DATABASE_SSL=true

# --- GitHub OAuth App (GitHub > Settings > Developer settings > OAuth Apps) ---
# Authorization callback URL phải là: http://localhost:4000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Webhook ---
# Chuỗi bí mật bất kỳ để xác thực webhook do GitHub gửi tới
GITHUB_WEBHOOK_SECRET=
# Địa chỉ công khai mà GitHub gửi webhook tới. Khi code ở máy cá nhân, dùng kênh smee.io (https://smee.io/new)
WEBHOOK_URL=https://smee.io/xxxxxxxxxxxxxxxx

# --- Bảo mật ---
# Khóa ký phiên đăng nhập, chuỗi ngẫu nhiên dài từ 16 ký tự
JWT_SECRET=
# Khóa mã hóa token GitHub trong database, đúng 64 ký tự hex.
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# --- AI (Gemini, gói miễn phí) ---
# Lấy khóa tại https://aistudio.google.com. Bỏ trống thì các chức năng AI báo lỗi "chưa cấu hình".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Độ giống tối thiểu (0 đến 1) để một issue được coi là ứng viên trùng
DUPLICATE_MIN_SIMILARITY=0.6

# --- Khác ---
# Lệch múi giờ so với UTC tính bằng phút, dùng để chia tuần cho dashboard (Việt Nam = 420)
TZ_OFFSET_MINUTES=420
