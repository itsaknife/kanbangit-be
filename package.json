{
  "name": "kangitban-be",
  "version": "0.0.1",
  "description": "Backend của hệ thống quản lý công việc nhóm tích hợp GitHub và AI (NestJS)",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "npm exec --yes --package=prisma@7.10.1 -- prisma generate",
    "db:validate": "npm exec --yes --package=prisma@7.10.1 -- prisma validate",
    "db:migrate": "npm exec --yes --package=prisma@7.10.1 -- prisma migrate deploy",
    "db:push": "npm exec --yes --package=prisma@7.10.1 -- prisma db push",
    "db:vector-index": "npm exec --yes --package=prisma@7.10.1 -- prisma db execute --file prisma/sql/pgvector-index.sql",
    "db:studio": "npm exec --yes --package=prisma@7.10.1 -- prisma studio",
    "postinstall": "npm run db:generate"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.1.2",
    "@nestjs/websockets": "^12.1.2",
    "@octokit/webhooks": "^14.2.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "octokit": "^5.0.5",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "prisma": "^8.0.0-rc.33",
    "socket.io-client": "^4.8.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
