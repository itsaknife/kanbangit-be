// Cấu trúc database của hệ thống.
// Địa chỉ kết nối nằm trong prisma.config.ts (đọc từ biến DATABASE_URL), không viết ở đây.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// UUID nội bộ; githubId liên kết tài khoản GitHub, độc lập với id.
model User {
  id          String   @id @default(uuid())
  legacyId    Int?     @unique
  githubId    BigInt   @unique
  login       String   @unique
  name        String?
  avatarUrl   String
  displayName String?
  customAvatarUrl String?
  /// Token GitHub đã mã hóa (AES-256-GCM), dùng để gọi GitHub thay mặt người dùng.
  accessToken String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  connectedRepositories Repository[]
  weeklySummaries       WeeklySummary[]
  memberships           RepositoryMember[]
  mentions CommentMention[]
  notifications Notification[]
}

/// Repository đã kết nối; UUID nội bộ độc lập với githubId.
model Repository {
  id            String   @id @default(uuid())
  legacyId      Int?     @unique
  githubId      BigInt   @unique
  name          String
  owner         String
  fullName      String   @unique
  description   String?
  isPrivate     Boolean
  /// Id webhook đã đăng ký trên GitHub (để biết đã đăng ký chưa).
  webhookId     BigInt?
  connectedById String
  connectedBy   User     @relation(fields: [connectedById], references: [id])
  connectedAt   DateTime @default(now())
  importCompleted Boolean @default(false)

  issues          Issue[]
  weeklySummaries WeeklySummary[]
  members         RepositoryMember[]
  trackers        Tracker[]
  trackerPrefixes TrackerPrefix[]
  syncJobs SyncJob[]
  webhookEvents WebhookEvent[]
  notifications Notification[]
}

enum RepositoryRole {
  OWNER
  MEMBER
}

enum GithubPermission {
  ADMIN
  MAINTAIN
  WRITE
  TRIAGE
  READ
  UNKNOWN
}

model RepositoryMember {
  id               String @id @default(uuid())
  repositoryId     String
  repository       Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  githubUserId     BigInt
  login            String
  avatarUrl        String?
  githubPermission GithubPermission @default(UNKNOWN)
  userId           String?
  user             User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  role             RepositoryRole @default(MEMBER)
  isActive         Boolean @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  assignedIssues Issue[]
  statusChanges IssueStatusHistory[]
  worklogs Worklog[]
  comments Comment[]

  @@unique([repositoryId, githubUserId])
  @@unique([id, repositoryId])
  @@index([repositoryId, login])
  @@index([userId])
}

model Tracker {
  id           String @id @default(uuid())
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  name         String
  prefix       String
  color        String
  isActive     Boolean @default(true)
  displayOrder Int @default(0)
  nextSequence Int @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  issues       Issue[]
  prefixes     TrackerPrefix[]

  @@unique([id, repositoryId])
  @@unique([repositoryId, name])
  @@unique([repositoryId, prefix])
  @@index([repositoryId, isActive])
}

model TrackerPrefix {
  id           String @id @default(uuid())
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  trackerId    String
  tracker      Tracker @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  prefix       String

  @@unique([repositoryId, prefix])
}

enum IssueState {
  open
  closed
}

/// Trạng thái KanbanGit; chỉ closed/canceled ánh xạ sang GitHub closed.
enum IssueStatus {
  todo
  in_progress
  done
  verified
  closed
  reopen
  rejected
  paused
  canceled
}

enum SyncStatus {
  PENDING_SYNC
  SYNCED
  NEEDS_ATTENTION
}

/// Issue do KanbanGit quản lý. GitHub identifiers nullable cho tới khi sync tạo issue thành công.
model Issue {
  id           String      @id @default(uuid())
  legacyId     Int?        @unique
  githubId     BigInt?
  repoId       String
  repository   Repository  @relation(fields: [repoId], references: [id], onDelete: Cascade)
  number       Int?
  issueCode    String
  trackerId    String
  tracker      Tracker @relation(fields: [trackerId, repoId], references: [id, repositoryId], onDelete: Restrict)
  title        String
  body         String?
  state        IssueState
  status       IssueStatus
  /// Mảng { name, color }. Không chứa nhãn trạng thái "in progress".
  labels       Json        @default("[]")
  /// Mảng { login, avatarUrl }.
  assignees    Json        @default("[]")
  authorLogin  String?
  authorAvatar String?
  htmlUrl      String?
  /// Thời điểm cập nhật cuối theo GitHub, dùng để bỏ qua webhook trùng với thay đổi do chính app gây ra.
  githubUpdatedAt DateTime?
  githubCreatedAt DateTime?
  closedAt     DateTime?
  /// Hạn hoàn thành do Kanbangit quản lý; GitHub Issues không có trường tương ứng.
  dueDate      DateTime?
  startDate DateTime? @db.Date
  endDate DateTime? @db.Date
  estimateMinutes Int?
  assigneeId String?
  assignee RepositoryMember? @relation(fields: [assigneeId, repoId], references: [id, repositoryId], onDelete: Restrict)
  parentId String?
  parent Issue? @relation("IssueHierarchy", fields: [parentId, repoId], references: [id, repoId], onDelete: Restrict)
  children Issue[] @relation("IssueHierarchy")
  statusHistory IssueStatusHistory[]
  syncStatus SyncStatus @default(SYNCED)
  syncVersion Int @default(0)
  lastSyncedAt DateTime?
  syncJobs SyncJob[]
  notifications Notification[]
  worklogs Worklog[]
  comments Comment[]
  /// Vector ý nghĩa của issue (768 chiều) để tìm issue gần giống. Tạo cột bằng Prisma, chỉ đọc/ghi bằng SQL thô.
  embedding    Unsupported("vector(768)")?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([repoId, number])
  @@unique([id, repoId])
  @@unique([repoId, issueCode])
  @@index([repoId, trackerId])
  @@unique([githubId])
  @@index([repoId, status])
  @@index([repoId, closedAt])
  @@index([repoId, dueDate])
  @@index([repoId, endDate])
  @@index([repoId, parentId])
  @@index([repoId, assigneeId])
}

model Worklog {
  id String @id @default(uuid())
  issueId String
  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  memberId String
  member RepositoryMember @relation(fields: [memberId], references: [id], onDelete: Restrict)
  githubUserId BigInt
  startAt DateTime @db.Timestamptz(3)
  endAt DateTime @db.Timestamptz(3)
  durationMinutes Float
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([issueId, startAt])
  @@index([memberId, startAt])
  @@index([githubUserId, startAt, endAt])
}

model Comment {
  id String @id @default(uuid())
  issueId String
  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  authorId String
  author RepositoryMember @relation(fields: [authorId], references: [id], onDelete: Restrict)
  content String
  mentions CommentMention[]
  attachments Attachment[]
  notifications Notification[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([issueId, createdAt])
}

// Persist delivered recipients even when the mention is removed from the content.
model CommentMention {
  id String @id @default(uuid())
  commentId String
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([commentId, userId])
}

model Attachment {
  id String @id @default(uuid())
  commentId String
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  fileName String
  mimeType String
  fileSize Int
  storageKey String @unique
  createdAt DateTime @default(now())
  @@index([commentId])
}

// M4 only delivers mentions. Other notification groups/preferences/email are M6.
model Notification {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositoryId String
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  issueId String
  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  commentId String
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  type String @default("MENTION")
  readAt DateTime?
  createdAt DateTime @default(now())
  @@unique([commentId, userId])
  @@index([userId, createdAt])
}

model IssueStatusHistory {
  id String @id @default(uuid())
  issueId String
  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  fromStatus IssueStatus?
  toStatus IssueStatus
  changedById String?
  changedBy RepositoryMember? @relation(fields: [changedById], references: [id], onDelete: SetNull)
  source String @default("APP")
  createdAt DateTime @default(now())
  @@index([issueId, createdAt])
}

// Durable outbox. A partial SQL index permits only one active job per issue.
model SyncJob {
  id String @id @default(uuid())
  repositoryId String
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  issueId String
  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  operation String
  status String @default("PENDING")
  idempotencyKey String @unique
  createdAt DateTime @default(now())
  retryCount Int @default(0)
  nextRetryAt DateTime?
  lastError String?
  processedAt DateTime?
  updatedAt DateTime @default(now()) @updatedAt
  @@index([issueId, status])
  @@index([status, nextRetryAt])
  @@index([repositoryId, status])
}

model WebhookEvent {
  id String @id @default(uuid())
  repositoryId String
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  githubDeliveryId String @unique
  eventType String
  processedAt DateTime?
  createdAt DateTime @default(now())
  @@index([repositoryId, createdAt])
}

/// Báo cáo tiến độ tuần do LLM viết.
model WeeklySummary {
  id          String     @id @default(uuid())
  legacyId    Int?       @unique
  repoId      String
  repository  Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)
  weekStart   String     // yyyy-MM-dd (thứ Hai)
  weekEnd     String     // yyyy-MM-dd (Chủ nhật)
  content     String
  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())

  @@index([repoId, createdAt])
}
