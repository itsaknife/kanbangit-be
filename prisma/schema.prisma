// Cấu trúc database của hệ thống.
// Địa chỉ kết nối nằm trong prisma.config.ts (đọc từ biến DATABASE_URL), không viết ở đây.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Người dùng đăng nhập bằng GitHub. id chính là id tài khoản GitHub.
model User {
  id          String   @id @default(uuid())
  legacyId    Int?     @unique
  githubId    BigInt   @unique
  login       String   @unique
  name        String?
  avatarUrl   String
  /// Token GitHub đã mã hóa (AES-256-GCM), dùng để gọi GitHub thay mặt người dùng.
  accessToken String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  connectedRepositories Repository[]
  weeklySummaries       WeeklySummary[]
  memberships           RepositoryMember[]
}

/// Repository đã được kết nối vào hệ thống. id chính là id repository trên GitHub.
model Repository {
  id            String   @id @default(uuid())
  legacyId      Int?     @unique
  githubId      BigInt   @unique
  name          String
  owner         String
  fullName      String   @unique
  description   String?
  isPrivate     Boolean
  /// Id webhook đã đăng ký trên GitHub (để biết đã đăng ký chưa).
  webhookId     BigInt?
  connectedById String
  connectedBy   User     @relation(fields: [connectedById], references: [id])
  connectedAt   DateTime @default(now())
  importCompleted Boolean @default(false)

  issues          Issue[]
  weeklySummaries WeeklySummary[]
  members         RepositoryMember[]
  trackers        Tracker[]
  trackerPrefixes TrackerPrefix[]
}

enum RepositoryRole {
  OWNER
  MEMBER
}

enum GithubPermission {
  ADMIN
  MAINTAIN
  WRITE
  TRIAGE
  READ
  UNKNOWN
}

model RepositoryMember {
  id               String @id @default(uuid())
  repositoryId     String
  repository       Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  githubUserId     BigInt
  login            String
  avatarUrl        String?
  githubPermission GithubPermission @default(UNKNOWN)
  userId           String?
  user             User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  role             RepositoryRole @default(MEMBER)
  isActive         Boolean @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([repositoryId, githubUserId])
  @@index([userId])
}

model Tracker {
  id           String @id @default(uuid())
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  name         String
  prefix       String
  color        String
  isActive     Boolean @default(true)
  displayOrder Int @default(0)
  nextSequence Int @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  issues       Issue[]
  prefixes     TrackerPrefix[]

  @@unique([id, repositoryId])
  @@unique([repositoryId, name])
  @@unique([repositoryId, prefix])
}

model TrackerPrefix {
  id           String @id @default(uuid())
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  trackerId    String
  tracker      Tracker @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  prefix       String

  @@unique([repositoryId, prefix])
}

enum IssueState {
  open
  closed
}

/// Cột trên bảng Kanban. Trên GitHub: done = issue đã đóng, in_progress = đang mở + nhãn "in progress".
enum IssueStatus {
  todo
  in_progress
  done
}

/// Bản sao issue từ GitHub. GitHub vẫn là nguồn gốc, bảng này để xem nhanh, thống kê và tìm issue trùng.
model Issue {
  id           String      @id @default(uuid())
  legacyId     Int?        @unique
  githubId     BigInt
  repoId       String
  repository   Repository  @relation(fields: [repoId], references: [id], onDelete: Cascade)
  number       Int
  issueCode    String
  trackerId    String
  tracker      Tracker @relation(fields: [trackerId, repoId], references: [id, repositoryId], onDelete: Restrict)
  title        String
  body         String?
  state        IssueState
  status       IssueStatus
  /// Mảng { name, color }. Không chứa nhãn trạng thái "in progress".
  labels       Json        @default("[]")
  /// Mảng { login, avatarUrl }.
  assignees    Json        @default("[]")
  authorLogin  String?
  authorAvatar String?
  htmlUrl      String
  /// Thời điểm cập nhật cuối theo GitHub, dùng để bỏ qua webhook trùng với thay đổi do chính app gây ra.
  githubUpdatedAt DateTime
  githubCreatedAt DateTime
  closedAt     DateTime?
  /// Hạn hoàn thành do Kanbangit quản lý; GitHub Issues không có trường tương ứng.
  dueDate      DateTime?
  /// Vector ý nghĩa của issue (768 chiều) để tìm issue gần giống. Tạo cột bằng Prisma, chỉ đọc/ghi bằng SQL thô.
  embedding    Unsupported("vector(768)")?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([repoId, number])
  @@unique([repoId, issueCode])
  @@index([repoId, trackerId])
  @@unique([githubId])
  @@index([repoId, status])
  @@index([repoId, closedAt])
  @@index([repoId, dueDate])
}

/// Báo cáo tiến độ tuần do LLM viết.
model WeeklySummary {
  id          String     @id @default(uuid())
  legacyId    Int?       @unique
  repoId      String
  repository  Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)
  weekStart   String     // yyyy-MM-dd (thứ Hai)
  weekEnd     String     // yyyy-MM-dd (Chủ nhật)
  content     String
  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())

  @@index([repoId, createdAt])
}
